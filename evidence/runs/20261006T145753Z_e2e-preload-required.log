== source of this check
#!/usr/bin/env bash
# Throwaway check for task 2.6 of the change browser-e2e (HD-E13, HD-E21). It is not part of the repository; its
# source is printed below so that the record holds it. Run from the repository root.
#
# It starts the production server with the command of playwright.config.ts twice, each time with the stub made
# unable to load, and exits 0 only when the server process exited with an error both times and nothing listened on
# port 3100. A server that refuses to start is the EXPECTED behaviour of the harness here. It is not a product RED.
set -u

echo "== source of this check"
cat "$0"
echo "== end of source"
echo

PORT=3100
listening() { netstat -ano -p TCP | grep -E ":$PORT +.*LISTENING"; }
unexpected=0

if listening; then
  echo "ABORT: something already listens on port $PORT, so the check would show nothing."
  exit 2
fi

check() {
  code=$1
  echo "server exit code: $code"
  if [ "$code" -eq 0 ] || [ "$code" -eq 124 ]; then
    echo "UNEXPECTED: the server process did not exit with an error (124 means it had to be stopped after 30 s)."
    unexpected=1
  else
    echo "as expected: the server process exited with an error."
  fi
  if listening; then
    echo "UNEXPECTED: something listens on port $PORT."
    unexpected=1
  else
    echo "as expected: nothing listens on port $PORT."
  fi
}

echo "== case 1: the preload module does not exist"
echo "command: node --import ./e2e/support/does-not-exist.mjs ./node_modules/next/dist/bin/next start -p $PORT"
E2E_CROSSREF_RECORD=not-reached-in-this-case.jsonl \
  timeout 30 node --import ./e2e/support/does-not-exist.mjs ./node_modules/next/dist/bin/next start -p "$PORT"
check $?
echo

echo "== case 2: the stub is there, the location of the record (E2E_CROSSREF_RECORD) is not set"
echo "command: node --import ./e2e/support/crossref-stub.mjs ./node_modules/next/dist/bin/next start -p $PORT"
env -u E2E_CROSSREF_RECORD \
  timeout 30 node --import ./e2e/support/crossref-stub.mjs ./node_modules/next/dist/bin/next start -p "$PORT"
check $?
echo

if [ "$unexpected" -eq 0 ]; then
  echo "RESULT: in both cases the server refused to start. This is the expected behaviour of the harness, not a product RED."
else
  echo "RESULT: the server did not refuse to start in every case. The harness does not meet HD-E13."
fi
exit "$unexpected"
== end of source

