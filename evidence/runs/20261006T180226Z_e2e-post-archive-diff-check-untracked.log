== source of this check
#!/usr/bin/env bash
# Throwaway check, not part of the repository; the source is printed below so that the record holds it.
# Run from the repository root.
#
# `git diff --check` looks only at changes to files git already tracks. The uncommitted archive also holds NEW
# files, which that command does not see. This check applies the same test to each untracked file, by comparing it
# with an empty file, and changes nothing in the index.
#
# Pass criterion, fixed before the first run: files written for the archive and the handoff must be clean. Run
# records under evidence/runs/ are the verbatim output of commands and are never edited by hand (AGENTS.md), so
# whitespace that a tool printed into them is REPORTED here and is not counted as a failure of this check.
set -u

echo "== source of this check"
cat "$0"
echo "== end of source"
echo

authored_bad=0
record_notes=0

echo "== untracked files"
git ls-files --others --exclude-standard
echo

while IFS= read -r file; do
  out=$(git diff --no-index --check -- /dev/null "$file" 2>&1)
  case "$file" in
    evidence/runs/*)
      if [ -n "$out" ]; then
        record_notes=$((record_notes + 1))
        echo "-- run record, verbatim output: $file: $(printf '%s\n' "$out" | grep -c ': ') line(s) flagged, of this kind:"
        printf '%s\n' "$out" | grep ': ' | sed 's/^[^:]*:[0-9]*: //' | sort | uniq -c
      else
        echo "-- run record: $file: clean"
      fi
      ;;
    *)
      if [ -n "$out" ]; then
        authored_bad=$((authored_bad + 1))
        echo "-- UNEXPECTED: $file:"
        printf '%s\n' "$out"
      else
        echo "-- $file: clean"
      fi
      ;;
  esac
done < <(git ls-files --others --exclude-standard)

echo
echo "files of the archive and the handoff with a whitespace problem: $authored_bad"
echo "run records in which a tool printed flagged whitespace (reported, not counted): $record_notes"
if [ "$authored_bad" -eq 0 ]; then
  echo "RESULT: every untracked file written for the archive is clean."
else
  echo "RESULT: at least one untracked file written for the archive has a whitespace problem."
fi
exit "$authored_bad"
