== Source of the throwaway driver (kept outside the repository)
// Throwaway driver for task 4.4 of the change bibliography-workspace: drives a real Chrome through the primary flow
// of the workspace served by `next dev`, against live Crossref. It lives outside the repository and uses no package:
// Chrome is started with a throwaway profile and driven over the DevTools protocol with Node's own WebSocket.
// It clicks and types through real input events. Every observation printed is read back from the page, the
// clipboard or the network; nothing is asserted that was not observed.
import { spawn } from "node:child_process";
import fs from "node:fs";
import path from "node:path";

const APP = process.env.APP_URL ?? "http://localhost:3100";
const CHROME = "C:/Program Files/Google/Chrome/Application/chrome.exe";
const PORT = 9333;
const OUT = path.dirname(new URL(import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, "$1"));
const PROFILE = path.join(OUT, "chrome-profile");
const SHOTS = path.join(OUT, "shots");
const HEADED = process.env.HEADED === "1";

const TE = "\u0422", ES = "\u0421", NUMERO = "\u2116", EM = "\u2014";
const DOI1 = "10.1038/nature12373";
const DOI2 = "10.1371/journal.pone.0000308";
// Written by hand from the Crossref records of these DOIs as recorded in the repository on 2026-10-05.
const REF1 = `Nanometre-scale thermometry in a living cell / G. Kucsko, P. C. Maurer, N. Y. Yao, M. Kubo, H. J. Noh, P. K. Lo, H. Park, M. D. Lukin // Nature. 2013. ${TE}. 500, ${NUMERO} 7460. ${ES}. 54${EM}58. DOI: 10.1038/nature12373.`;
const REF2 = `Piwowar, Heather A.; Day, Roger S.; Fridsma, Douglas B. Sharing Detailed Research Data Is Associated with Increased Citation Rate // PLoS ONE. 2007. ${TE}. 2, ${NUMERO} 3. ${ES}. e308. DOI: 10.1371/journal.pone.0000308.`;

const UI = {
  add: "Додати",
  doiLabel: "DOI статті",
  duplicate: "Ця публікація вже є в переліку.",
  invalidInput: "Це не схоже на DOI. Введіть один DOI у вигляді 10.xxxx/\u2026, doi:10.xxxx/\u2026 або https://doi.org/10.xxxx/\u2026",
  sessionNotice: "Перелік зберігається лише до перезавантаження сторінки.",
  emptyList: "Перелік порожній. Додайте першу статтю за DOI.",
  copyAll: "Копіювати весь перелік",
  copied: "Скопійовано.",
  copyFailed: "Не вдалося скопіювати. Виділіть текст і скопіюйте його вручну.",
  blocked: (n) => `Щоб скопіювати весь перелік, виправте або вилучіть записи, для яких не сформовано посилання: ${n}.`,
  cannot: (f) => `Не вдалося сформувати посилання. Бракує: ${f}.`,
  gaps: (f) => `Не вказано в метаданих: ${f}.`,
  invalidYear: "Рік має складатися з чотирьох цифр, від 1000 до 9999.",
  subtitleWarning: "Підзаголовок починається з великої літери. Програма не змінює регістр \u2014 перевірте його.",
  copyOne: (n) => `Копіювати: запис ${n}`,
  correct: (n) => `Редагувати: запис ${n}`,
  remove: (n) => `Вилучити: запис ${n}`,
  up: (n) => `Вище: запис ${n}`,
  down: (n) => `Нижче: запис ${n}`,
  removeAuthor: (n) => `Вилучити: автор ${n}`,
  save: "Зберегти",
  cancel: "Скасувати",
};

// ---------------------------------------------------------------- output
let failures = 0;
let checks = 0;
const say = (line = "") => console.log(line);
const step = (title) => say(`\n== ${title}`);
const seen = (what, value) => say(`   observed ${what}: ${typeof value === "string" ? value : JSON.stringify(value)}`);
const check = (what, ok, detail = "") => {
  checks += 1;
  if (!ok) failures += 1;
  say(`   ${ok ? "ok        " : "UNEXPECTED"} ${what}${detail ? ` -- ${detail}` : ""}`);
  return ok;
};
const same = (what, actual, expected) =>
  check(what, actual === expected, actual === expected ? "" : `expected ${JSON.stringify(expected)}, observed ${JSON.stringify(actual)}`);

// ---------------------------------------------------------------- DevTools protocol
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

async function connect(url) {
  const socket = new WebSocket(url);
  await new Promise((resolve, reject) => {
    socket.addEventListener("open", resolve, { once: true });
    socket.addEventListener("error", () => reject(new Error(`cannot connect to ${url}`)), { once: true });
  });
  let next = 0;
  const waiting = new Map();
  const listeners = [];
  socket.addEventListener("message", (event) => {
    const message = JSON.parse(event.data);
    if (message.id !== undefined) {
      const entry = waiting.get(message.id);
      waiting.delete(message.id);
      if (message.error) entry.reject(new Error(`${entry.method}: ${message.error.message}`));
      else entry.resolve(message.result);
    } else for (const listener of listeners) listener(message);
  });
  return {
    send: (method, params = {}) =>
      new Promise((resolve, reject) => {
        const id = ++next;
        waiting.set(id, { resolve, reject, method });
        socket.send(JSON.stringify({ id, method, params }));
      }),
    on: (listener) => listeners.push(listener),
    close: () => socket.close(),
  };
}

fs.rmSync(PROFILE, { recursive: true, force: true });
fs.mkdirSync(SHOTS, { recursive: true });
const chrome = spawn(
  CHROME,
  [
    ...(HEADED ? [] : ["--headless=new"]),
    `--remote-debugging-port=${PORT}`,
    `--user-data-dir=${PROFILE}`,
    "--no-first-run",
    "--no-default-browser-check",
    "--window-size=1280,1600",
    "about:blank",
  ],
  { stdio: "ignore" },
);

let version;
for (let attempt = 0; attempt < 100 && !version; attempt += 1) {
  try {
    version = await (await fetch(`http://127.0.0.1:${PORT}/json/version`)).json();
  } catch {
    await sleep(100);
  }
}
process.on("exit", () => chrome.kill());
if (!version) throw new Error("Chrome did not start");

const browser = await connect(version.webSocketDebuggerUrl);
const targets = await (await fetch(`http://127.0.0.1:${PORT}/json/list`)).json();
const page = await connect(targets.find((target) => target.type === "page").webSocketDebuggerUrl);

// ---------------------------------------------------------------- what the browser does on the network
const requests = new Map(); // requestId -> { method, url, type, nextAction, status }
const consoleProblems = [];
page.on((message) => {
  const p = message.params;
  if (message.method === "Network.requestWillBeSent") {
    const headers = Object.fromEntries(Object.entries(p.request.headers).map(([k, v]) => [k.toLowerCase(), v]));
    requests.set(p.requestId, {
      method: p.request.method,
      url: p.request.url,
      type: p.type,
      nextAction: headers["next-action"] !== undefined,
      postData: p.request.postData,
    });
  } else if (message.method === "Network.responseReceived") {
    const request = requests.get(p.requestId);
    if (request) request.status = p.response.status;
  } else if (message.method === "Network.loadingFinished") {
    const request = requests.get(p.requestId);
    if (request) request.finished = true;
  } else if (message.method === "Runtime.exceptionThrown") {
    consoleProblems.push(`exception: ${p.exceptionDetails.text} ${p.exceptionDetails.exception?.description ?? ""}`);
  } else if (message.method === "Runtime.consoleAPICalled" && p.type === "error") {
    consoleProblems.push(`console.error: ${p.args.map((a) => a.value ?? a.description ?? "").join(" ")}`);
  }
});

await page.send("Page.enable");
await page.send("Runtime.enable");
await page.send("Network.enable", { maxPostDataSize: 65536 });
await page.send("Emulation.setDeviceMetricsOverride", { width: 1280, height: 1600, deviceScaleFactor: 1, mobile: false });
await page.send("Emulation.setFocusEmulationEnabled", { enabled: true });
await browser.send("Browser.grantPermissions", {
  origin: APP,
  permissions: ["clipboardReadWrite", "clipboardSanitizedWrite"],
});

// Helpers that live in the page: they only find and read; every action goes through real input events.
await page.send("Page.addScriptToEvaluateOnNewDocument", {
  source: `window.__t = {
    text: (el) => (el.textContent || "").replace(/\\s+/g, " ").trim(),
    button(name) {
      return [...document.querySelectorAll("button")].find(
        (b) => (b.getAttribute("aria-label") || this.text(b)) === name,
      );
    },
    field(label) {
      const scope = document.querySelector("form[aria-labelledby]") || document;
      const found = [...scope.querySelectorAll("label")].find((l) => this.text(l) === label)
        || [...document.querySelectorAll("label")].find((l) => this.text(l) === label);
      return found ? document.getElementById(found.htmlFor) : null;
    },
    entries() {
      const list = document.querySelector('ul[role="list"]');
      if (!list) return [];
      return [...list.children].map((li) => {
        const form = li.querySelector("form");
        const own = (el) => !form || !form.contains(el);
        return {
          lines: [...li.querySelectorAll("p")].filter(own).map((p) => this.text(p)),
          buttons: [...li.querySelectorAll("button")].filter(own).map((b) => ({
            name: b.getAttribute("aria-label") || this.text(b), disabled: b.disabled,
          })),
          correcting: Boolean(form),
        };
      });
    },
    page() {
      const copyAll = this.button("${UI.copyAll}");
      return {
        lang: document.documentElement.lang,
        title: document.title,
        h1: this.text(document.querySelector("h1") || document.body),
        h2: [...document.querySelectorAll("h2")].map((h) => this.text(h)),
        alerts: [...document.querySelectorAll('[role="alert"]')].map((a) => this.text(a)),
        statuses: [...document.querySelectorAll('[role="status"]')].map((a) => this.text(a)),
        doiField: (this.field("${UI.doiLabel}") || {}).value,
        addDisabled: (this.button("${UI.add}") || {}).disabled,
        copyAllShown: Boolean(copyAll),
        copyAllDisabled: copyAll ? copyAll.disabled : null,
        body: this.text(document.body),
      };
    },
    form() {
      const form = document.querySelector("form[aria-labelledby]");
      if (!form) return null;
      const fields = {};
      for (const label of form.querySelectorAll("label")) {
        const input = document.getElementById(label.htmlFor);
        if (input && input.tagName === "INPUT" && !input.closest("fieldset fieldset")) {
          fields[this.text(label)] = { value: input.value, readOnly: input.readOnly };
        }
      }
      const authors = [...form.querySelectorAll("fieldset fieldset")].map((row) => ({
        legend: this.text(row.querySelector("legend")),
        kind: this.text(row.querySelector("select").selectedOptions[0]),
        values: [...row.querySelectorAll("input")].map((i) => i.value),
      }));
      return { fields, authors, alerts: [...form.querySelectorAll('[role="alert"]')].map((a) => this.text(a)) };
    },
  };`,
});

const evaluate = async (expression) => {
  const { result, exceptionDetails } = await page.send("Runtime.evaluate", {
    expression,
    returnByValue: true,
    awaitPromise: true,
  });
  if (exceptionDetails) throw new Error(`page: ${exceptionDetails.exception?.description ?? exceptionDetails.text}`);
  return result.value;
};

const entries = () => evaluate("window.__t.entries()");
const pageState = () => evaluate("window.__t.page()");
const formState = () => evaluate("window.__t.form()");
const clipboard = () => evaluate("navigator.clipboard.readText().catch((e) => 'CLIPBOARD READ FAILED: ' + e.name)");

async function until(what, read, accept, timeout = 20000) {
  const started = Date.now();
  let last;
  while (Date.now() - started < timeout) {
    last = await read();
    if (accept(last)) return last;
    await sleep(100);
  }
  check(`waited for ${what}`, false, `not seen within ${timeout} ms; last: ${JSON.stringify(last)?.slice(0, 300)}`);
  return last;
}

// The centre of an element after it is scrolled into view, or null when there is none.
const locate = (finder) =>
  evaluate(`(() => { const el = ${finder}; if (!el) return null; el.scrollIntoView({ block: "center" });
    const r = el.getBoundingClientRect(); return { x: r.x + r.width / 2, y: r.y + r.height / 2, disabled: Boolean(el.disabled) }; })()`);

async function clickAt(point) {
  await page.send("Input.dispatchMouseEvent", { type: "mouseMoved", x: point.x, y: point.y });
  await page.send("Input.dispatchMouseEvent", { type: "mousePressed", x: point.x, y: point.y, button: "left", clickCount: 1 });
  await page.send("Input.dispatchMouseEvent", { type: "mouseReleased", x: point.x, y: point.y, button: "left", clickCount: 1 });
}

async function press(name) {
  const point = await locate(`window.__t.button(${JSON.stringify(name)})`);
  if (!point) return check(`control «${name}» exists`, false);
  await clickAt(point);
  return true;
}

const key = async (keyName, code, virtualKey, extra = {}) => {
  await page.send("Input.dispatchKeyEvent", { type: "keyDown", key: keyName, code, windowsVirtualKeyCode: virtualKey, ...extra });
  await page.send("Input.dispatchKeyEvent", { type: "keyUp", key: keyName, code, windowsVirtualKeyCode: virtualKey, ...extra });
};

// Clicks into a field, selects what it holds and types over it; an empty text empties the field.
async function type(label, text) {
  const point = await locate(`window.__t.field(${JSON.stringify(label)})`);
  if (!point) return check(`field «${label}» exists`, false);
  await clickAt(point);
  await key("a", "KeyA", 65, { modifiers: 2, commands: ["selectAll"] });
  if (text === "") await key("Backspace", "Backspace", 8);
  else await page.send("Input.insertText", { text });
  return true;
}

let shot = 0;
// A screenshot is a convenience for the person running the check and is kept outside the repository; a failure to
// take one is reported and does not end the check.
async function screenshot(name) {
  try {
    const { data } = await page.send("Page.captureScreenshot", { format: "png" });
    const file = path.join(SHOTS, `${String(++shot).padStart(2, "0")}-${name}.png`);
    fs.writeFileSync(file, Buffer.from(data, "base64"));
  } catch (error) {
    say(`   (screenshot «${name}» was not taken: ${error.message})`);
  }
}

const actionPosts = () => [...requests.values()].filter((r) => r.method === "POST" && r.nextAction);

async function submitDoi(text) {
  await type(UI.doiLabel, text);
  await press(UI.add);
}

async function addAndWait(text, count) {
  const before = actionPosts().length;
  await submitDoi(text);
  const pending = await pageState();
  seen("just after submitting", { statuses: pending.statuses, addDisabled: pending.addDisabled });
  await until(`entry ${count}`, entries, (list) => list.length === count, 30000);
  same("one request to the Server Function for this DOI", actionPosts().length, before + 1);
}

