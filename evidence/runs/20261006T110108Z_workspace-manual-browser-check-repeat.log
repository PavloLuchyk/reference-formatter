let scanned = 0;
const hits = [];
for (const [requestId, request] of requests) {
  if (!request.finished) continue;
  try {
    const { body, base64Encoded } = await page.send("Network.getResponseBody", { requestId });
    const text = base64Encoded ? Buffer.from(body, "base64").toString("latin1") : body;
    scanned += 1;
    for (const needle of ["CROSSREF_CONTACT_EMAIL", "mailto:", "api.crossref.org"]) {
      if (text.includes(needle)) hits.push(`${needle} in ${request.url}`);
    }
  } catch {
    // The body of this response is no longer kept by the browser.
  }
}
seen("response bodies scanned", { scanned, of: all.length });
seen("mentions of the contact variable, a mailto address or the Crossref address", hits);
check("nothing sent to the browser names the contact variable or a contact address", !hits.some((h) => h.startsWith("CROSSREF_CONTACT_EMAIL") || h.startsWith("mailto:")));
check("nothing sent to the browser holds the Crossref address: the lookup code is not in client code", !hits.some((h) => h.startsWith("api.crossref.org")));
seen("console errors and exceptions in the page", consoleProblems);
same("no console error or exception", consoleProblems.length, 0);

step("10. The clipboard calls of the whole check, and the browser alone");
same("the application called writeText four times: one reference and three times the whole list", writesInAll, 4);
seen(
  "this browser alone, without the application: control characters read back after writeText('a\\nb')",
  await evaluate(`(async () => { await navigator.clipboard.writeText("a\\nb");
    return [...(await navigator.clipboard.readText())].map((c) => c.charCodeAt(0)).filter((n) => n < 32); })()`),
);

say(`\n== Result`);
say(`   finished: ${new Date().toISOString()}`);
say(`   checks: ${checks}, unexpected: ${failures}`);
say(`   ${failures === 0 ? "PASS" : "FAIL"}`);

page.close();
browser.close();
chrome.kill();
await sleep(300);

if (process.env.PRINT_SOURCE === "1") {
  say(`\n== Source of the throwaway driver (kept outside the repository)`);
  say(fs.readFileSync(new URL(import.meta.url), "utf8"));
}
process.exit(failures === 0 ? 0 : 1);

