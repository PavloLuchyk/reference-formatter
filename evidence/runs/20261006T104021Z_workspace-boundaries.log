# Boundary searches for task 4.1 of the change bibliography-workspace. Prints every search and its result.
set -u
none() { echo "  (none)"; }

echo "## 1. lib/bibliography/: imports of react, next or the Crossref provider; process.env; network"
grep -rn -E "from \"(react|next)[\"/]|lib/metadata/crossref|process\.env|fetch\(|XMLHttpRequest|navigator\." lib/bibliography || none

echo "## 2. lib/bibliography/: every import, for reading"
grep -rhn -E "^import " lib/bibliography --include=*.ts | grep -v "\.test\.ts" | sed -E 's/^[0-9]+://' | sort | uniq -c

echo "## 3. app/: imports of the Crossref provider"
grep -rn "lib/metadata/crossref" app || none

echo "## 4. files with a 'use client' directive"
grep -rln -E "^[\"']use client[\"']" app lib || none

echo "## 5. files with a 'use server' directive"
grep -rln -E "^[\"']use server[\"']" app lib || none

echo "## 6. CROSSREF_CONTACT_EMAIL in source files"
grep -rn "CROSSREF_CONTACT_EMAIL" app lib scripts tests __tests__ next.config.ts package.json || none

echo "## 7. NEXT_PUBLIC_ in source files"
grep -rn "NEXT_PUBLIC_" app lib next.config.ts || none

echo "## 8. process.env in app/ and lib/"
grep -rn "process\.env" app lib || none

echo "## 9. built client files (.next/static) that contain the variable name or the Crossref address"
if [ -d .next/static ]; then
  grep -rl -E "CROSSREF_CONTACT_EMAIL|api\.crossref\.org|mailto:" .next/static || none
  echo "  files searched: $(find .next/static -type f | wc -l)"
else
  echo "  .next/static does not exist"; exit 1
fi

echo "## 10. .env files in the repository root, and in git status"
ls -a | grep -E "^\.env" || none
git status --short | grep -i "env" || none

echo "## 11. clipboard and copy mechanisms in app/"
grep -rn -E "clipboard|execCommand|createRange|\.select\(\)" app --include=*.ts --include=*.tsx | grep -v "\.test\." | grep -v "__fixtures__" || none

echo "## 12. every use of formatJournalArticle in tests and test support of this slice"
grep -rn "formatJournalArticle" app lib/bibliography --include=*.test.ts --include=*.test.tsx || none
grep -rn "formatJournalArticle" app/_components/__fixtures__ lib/bibliography/__fixtures__ || echo "  (none in test support)"

echo "## 13. expected texts taken from the formatter: toMatchSnapshot / toMatchInlineSnapshot"
grep -rn -E "toMatch(Inline)?Snapshot" app lib/bibliography || none
