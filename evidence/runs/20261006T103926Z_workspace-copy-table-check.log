const fs=require("fs");
const design=fs.readFileSync("openspec/changes/bibliography-workspace/design.md","utf8");
const code=fs.readFileSync("app/_components/copy.ts","utf8");
const start=design.indexOf("### Ukrainian copy (HUMAN-APPROVED");
const rows=design.slice(start).split(/\r?\n/).filter(l=>/^\| \d+ \|/.test(l)).map(l=>l.split("|").map(c=>c.trim())).map(c=>({n:c[1],where:c[2],text:c[3]}));
let missing=0;
for(const r of rows){
  // A row may hold several strings (separated by a middle dot), a placeholder, or an example after a dash.
  const main=r.text.split(" — for example")[0];
  const parts=main.split(" · ").flatMap(p=>p.split(/\{[a-z]+\}/)).map(p=>p.trim()).filter(p=>p.length>0);
  const lost=parts.filter(p=>!code.includes(p));
  if(lost.length){missing++;console.log("MISSING row "+r.n+" ("+r.where+"): "+JSON.stringify(lost));}
  else console.log("ok row "+r.n+": "+parts.length+" fragment(s)");
}
console.log(rows.length+" rows checked, "+missing+" with a missing fragment");
process.exit(missing?1:0);

