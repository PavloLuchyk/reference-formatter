// THROWAWAY, never committed: task 7.1 of openspec/changes/doi-resolution/tasks.md.
// Resolves one DOI against the live Crossref API through the real provider and the global fetch.
import { expect, test } from "vitest";
import { expectedPublications } from "@/lib/metadata/crossref/__fixtures__/expected";
import { resolveDoi } from "@/lib/metadata/resolve-doi";

test("live: 10.1038/nature12373 resolves through the real provider to the approved Publication", async () => {
  const requests: string[] = [];
  const recordingFetch: typeof fetch = async (input, init) => {
    const response = await fetch(input, init);
    requests.push(`${init?.method ?? "GET"} ${String(input)} -> HTTP ${response.status}`);
    return response;
  };

  const outcome = await resolveDoi("10.1038/nature12373", { fetch: recordingFetch, appName: "ReferenceFormatter" });

  console.log(`live check at ${new Date().toISOString()}`);
  console.log(`requests sent: ${requests.length}`);
  for (const request of requests) console.log(`  ${request}`);
  console.log(`outcome:\n${JSON.stringify(outcome, null, 2)}`);

  expect(requests).toEqual(["GET https://api.crossref.org/works/10.1038%2Fnature12373 -> HTTP 200"]);
  expect(outcome).toEqual({ ok: true, publication: expectedPublications["nature12373.json"] });
}, 20_000);
